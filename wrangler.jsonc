// Cloudflare settings: the website is served as static files from dist/ (the store's code runs on Supabase).
// Cloudflare builds it with "bash tools/build-site.sh" and publishes it with "npx wrangler deploy".
// worker/gate.js sits in front of the files: it does nothing unless the SITE_PASSWORD secret is set, in which
// case the whole site is behind a "Private access" page (see STORE-SETUP.md, "Closing the site while you edit").
{
  "name": "siaram-jewelry",
  "main": "worker/gate.js",
  "compatibility_date": "2026-10-01",
  // Keep variables added in the Cloudflare dashboard (such as SITE_PASSWORD saved as text) when the site is published.
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
