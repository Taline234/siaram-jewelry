// Cloudflare settings: the website is served as static files (no server code; the store's code runs on
// Supabase). Cloudflare builds it with "bash tools/build-site.sh" and publishes it with "npx wrangler deploy".
{
  "name": "siaram-jewelry",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
